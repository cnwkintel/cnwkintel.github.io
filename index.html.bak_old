<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>China Football Intel — Player Data</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Segoe UI", "Microsoft YaHei", sans-serif; background: #f4f6fb; color: #222; }
  header { background: linear-gradient(135deg,#0b2545,#13315c); color: #fff; padding: 34px 40px; }
  header h1 { font-size: 26px; letter-spacing: .5px; }
  header p { margin-top: 8px; opacity: .8; font-size: 13.5px; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 28px 20px 80px; }
  section h2 { font-size: 19px; border-left: 4px solid #0d99ff; padding-left: 12px; margin: 36px 0 14px; }
  .cards { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .card { background: #fff; border-radius: 12px; padding: 18px 20px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .card h3 { font-size: 16px; }
  .card .desc { color: #666; font-size: 13px; margin: 8px 0 14px; line-height: 1.7; }
  .card a.btn { display: inline-block; background: #0d99ff; color: #fff; text-decoration: none;
    padding: 8px 18px; border-radius: 8px; font-size: 13.5px; margin-right: 8px; margin-bottom: 6px; }
  .card a.btn.ghost { background: #eef4fb; color: #0b2545; }
  .card .ov { display: block; margin: 0 0 12px; border-radius: 8px; overflow: hidden;
    max-height: 320px; border: 1px solid #e6ebf3; cursor: zoom-in; position: relative; }
  .card .ov img { width: 100%; object-fit: cover; object-position: top; display: block; }
  .card .ov .hint { position: absolute; right: 10px; bottom: 8px; background: rgba(11,37,69,.75);
    color: #fff; font-size: 11px; padding: 3px 10px; border-radius: 12px; }
  .badge { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 2px 10px;
    border-radius: 20px; margin-left: 8px; vertical-align: 2px; }
  .badge.new { background: #e8f7ee; color: #1a7f37; }
  footer { text-align: center; color: #999; font-size: 12px; padding: 30px 0 40px; }
  /* Slide viewer lightbox */
  #lb { position: fixed; inset: 0; background: rgba(8,14,26,.95); display: none;
    align-items: center; justify-content: center; z-index: 99; }
  #lb.show { display: flex; }
  #lb img { max-width: 94vw; max-height: 88vh; border-radius: 6px; box-shadow: 0 10px 40px rgba(0,0,0,.5); }
  #lb .lb-cap { position: absolute; top: 16px; left: 0; right: 0; text-align: center;
    color: #fff; font-size: 14px; opacity: .9; }
  #lb .lb-close { position: absolute; top: 12px; right: 18px; color: #fff; font-size: 26px;
    cursor: pointer; opacity: .8; background: none; border: none; }
  #lb .lb-close:hover { opacity: 1; }
  #lb .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,.12);
    color: #fff; border: none; font-size: 34px; width: 52px; height: 52px; border-radius: 50%;
    cursor: pointer; line-height: 1; }
  #lb .lb-nav:hover { background: rgba(255,255,255,.25); }
  #lb .lb-prev { left: 18px; }
  #lb .lb-next { right: 18px; }
</style>
</head>
<body>
<header>
  <h1>China Football Intel</h1>
  <p>Updated 2026-08-22</p>
</header>
<div class="wrap">

  <section>
    <h2>Generation Reports</h2>
    <div class="cards">
      <div class="card">
        <h3>2003/04 Generation</h3>
        <a class="ov" href="javascript:void(0)" onclick="openSlides('03-04', 0)" title="Browse slides 1-6">
          <img src="images/ppt-03-04/slide-1.png" alt="Slide 1 of the 03-04 overview deck">
          <span class="hint">Slides 1-6 · click to browse</span>
        </a>
        <div class="desc">
          Full analysis of the 2003/04 age group: CSL / CL1 careers, Europe readiness,
          national-team results and player profiles (Transfermarkt + FotMob data).
        </div>
        <a class="btn" href="reports/generation_report.html" target="_blank">View Report</a>
        <a class="btn ghost" href="images/03-04players.png" target="_blank">View Player Overview</a>
      </div>
      <div class="card">
        <h3>2005/06 Generation</h3>
        <a class="ov" href="javascript:void(0)" onclick="openSlides('05-06', 0)" title="Browse slides 1-6">
          <img src="images/ppt-05-06/slide-1.png" alt="Slide 1 of the 05-06 overview deck">
          <span class="hint">Slides 1-6 · click to browse</span>
        </a>
        <div class="desc">
          103 qualified players (CSL / national-team / overseas / CL1 track records) with FotMob
          season stats, section rankings, impact table and player profiles.
        </div>
        <a class="btn" href="reports/generation_report_0506.html" target="_blank">View Report</a>
      </div>
      <div class="card">
        <h3>2007/08 Generation <span class="badge new">New</span></h3>
        <a class="ov" href="javascript:void(0)" onclick="openSlides('07-08', 0)" title="Browse slides 1-6">
          <img src="images/ppt-07-08/slide-1.png" alt="Slide 1 of the 07-08 overview deck">
          <span class="hint">Slides 1-6 · click to browse</span>
        </a>
        <div class="desc">
          94 qualified players (national youth teams / CSL &amp; CL1 appearances / overseas
          track records) with FotMob season ratings, section rankings and player profiles.
        </div>
        <a class="btn" href="reports/generation_report_0708.html" target="_blank">View Report</a>
      </div>
    </div>
  </section>

</div>
<footer>China Football Intel · Data sources: Transfermarkt / FotMob · Works fully offline (JS bundled locally)</footer>

<div id="lb" onclick="if(event.target===this) closeSlides()">
  <button class="lb-close" onclick="closeSlides()">✕</button>
  <button class="lb-nav lb-prev" onclick="prevSlide()">‹</button>
  <img id="lbImg" alt="slide">
  <button class="lb-nav lb-next" onclick="nextSlide()">›</button>
  <div class="lb-cap" id="lbCap"></div>
</div>

<script>
const DECKS = {
  "03-04": ["images/ppt-03-04/slide-1.png", "images/ppt-03-04/slide-2.png", "images/ppt-03-04/slide-3.png",
            "images/ppt-03-04/slide-4.png", "images/ppt-03-04/slide-5.png", "images/ppt-03-04/slide-6.png"],
  "05-06": ["images/ppt-05-06/slide-1.png", "images/ppt-05-06/slide-2.png", "images/ppt-05-06/slide-3.png",
            "images/ppt-05-06/slide-4.png", "images/ppt-05-06/slide-5.png", "images/ppt-05-06/slide-6.png"],
  "07-08": ["images/ppt-07-08/slide-1.png", "images/ppt-07-08/slide-2.png", "images/ppt-07-08/slide-3.png",
            "images/ppt-07-08/slide-4.png", "images/ppt-07-08/slide-5.png", "images/ppt-07-08/slide-6.png"],
};
let curDeck = "03-04", cur = 0;
const lb = document.getElementById("lb");
function openSlides(deck, i){ curDeck = deck; cur = (i + DECKS[deck].length) % DECKS[deck].length; showSlide(); lb.classList.add("show"); }
function closeSlides(){ lb.classList.remove("show"); }
function showSlide(){ document.getElementById("lbImg").src = DECKS[curDeck][cur];
  document.getElementById("lbCap").textContent = "Slide " + (cur + 1) + " / " + DECKS[curDeck].length; }
function nextSlide(){ openSlides(curDeck, cur + 1); }
function prevSlide(){ openSlides(curDeck, cur - 1); }
document.addEventListener("keydown", e => {
  if (!lb.classList.contains("show")) return;
  if (e.key === "Escape") closeSlides();
  if (e.key === "ArrowRight") nextSlide();
  if (e.key === "ArrowLeft") prevSlide();
});
</script>
</body>
</html>
